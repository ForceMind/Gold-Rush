[node name="WeaponDesc" type="Label" parent="HelpPanel/ScrollContainer/VBoxContainer" unique_id=813719417]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_fonts/font = ExtResource("2_chinese_font")
theme_override_font_sizes/font_size = 16
text = "基础升级：
- 疾速施法：射击间隔缩短 14%
- 重击魔弹：伤害 +1
- 分裂魔弹：弹丸数量 +1
- 穿透魔弹：穿透 +1 个敌人
- 迅捷魔弹：弹丸速度 +100
- 巨型魔弹：弹丸尺寸 +12%

特殊技能：
- 新星爆发：向四周发射 12 枚魔弹
- 环绕魔球：生成围绕玩家旋转的魔球
- 冰冻领域：冻住周围所有敌人"

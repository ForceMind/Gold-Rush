[node name="GameDesc" type="Label" parent="HelpPanel/ScrollContainer/VBoxContainer" unique_id=2009530385]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_fonts/font = ExtResource("2_chinese_font")
theme_override_font_sizes/font_size = 16
text = "操作方式：
- 键盘：WASD 或方向键移动
- 鼠标：点击鼠标控制按钮开启鼠标控制
- 手机：使用虚拟摇杆

游戏目标：
- 收集地图上的金币获得分数
- 消灭怪物获得额外分数
- 达到指定分数后可以选择武器升级
- 尽可能获得高分！

武器系统：
- 魔弹：自动射击最近的敌人
- 升级后可以解锁更多技能"
autowrap_mode = 2


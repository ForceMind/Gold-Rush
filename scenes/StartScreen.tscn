[node name="PickupDesc" type="Label" parent="HelpPanel/ScrollContainer/VBoxContainer" unique_id=316353594]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_fonts/font = ExtResource("2_chinese_font")
theme_override_font_sizes/font_size = 16
text = "击杀怪物有概率掉落道具：

[磁力] - 蓝色磁铁
自动吸附附近金币，持续 8 秒

[护盾] - 绿色盾牌
抵挡一次伤害，持续 8 秒

[加速鞋] - 黄色闪电
移动速度 +50%，持续 6 秒

[炸弹] - 灰色炸弹
立即对周围敌人造成大量伤害

[双倍金币] - 双金币
金币价值翻倍，持续 10 秒"
autowrap_mode = 2

